# Exclude local data and heavy build artifacts from Docker build context
.data
.git
bin
.env
.env.*
**/.env
**/.env.*
.codex
.agents

# Frontend caches and deps
web/node_modules
web/.next
web/.turbo
web/coverage
web/dist
web/out
web/.vercel

# OS/editor junk
.DS_Store
*.swp
*.log


# Local agent metadata and test outputs are not runtime sources.
.claude
**/__pycache__
web/test-results
web/playwright-report
