# =============================================================================
# BUDGET SERVICE CONFIGURATION
# =============================================================================

# Application Environment
APP_ENV=dev

# Official CBR history since 2025-01-01 and daily updates (disable with false).
FX_IMPORT_ENABLED=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Для локальной разработки (вне Docker)
DATABASE_URL=postgres://budget:budget@localhost:5432/budget?sslmode=disable
# Для Docker Compose
# DATABASE_URL=postgres://budget:budget@db:5432/budget?sslmode=disable

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Для локальной разработки (вне Docker)
REDIS_URL=redis://localhost:6379
# Для Docker Compose
# REDIS_URL=redis://redis:6379

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SIGN_KEY=dev-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
GOOGLE_CLIENT_ID=
AUTH_PASSWORD_ENABLED=false

# =============================================================================
# GRPC CONFIGURATION
# =============================================================================
GRPC_ADDR=0.0.0.0:8080
METRICS_ADDR=0.0.0.0:9090

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
OAUTH_AUTH_TOKEN_TTL=5m
OAUTH_SESSION_TTL=24h
OAUTH_VERIFICATION_CODE_TTL=10m
OAUTH_MAX_ATTEMPTS_PER_HOUR=10
OAUTH_MAX_ATTEMPTS_PER_10MIN=3
OAUTH_WEB_BASE_URL=http://localhost:3030

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_GRPC_BASE_URL=http://localhost:3030/grpc
NEXT_PUBLIC_APP_URL=http://localhost:3030
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ENVOY_URL=http://localhost:8081

# =============================================================================
# OBSERVABILITY (Optional)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify for production:
# APP_ENV=production
# OAUTH_WEB_BASE_URL=https://your-domain.com
# NEXT_PUBLIC_GRPC_BASE_URL=https://your-domain.com/grpc
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# JWT_SIGN_KEY=your-super-secret-production-key

# =============================================================================
# DOCKER PORTS CONFIGURATION
# =============================================================================
# Локально: порты открыты через docker-compose.override.yml
# На проде: порты закрыты, доступ только через nginx
# 
# Для локальной разработки используйте docker-compose.override.yml
# Для production НЕ используйте docker-compose.override.yml

# Opt-in investment module rollout. Set on BOTH budgetd and the web runtime.
# false/absent disables investment RPCs, navigation and /investments pages;
# existing journals remain stored. Standalone workers are controlled separately.
# Enabled budgetd also processes private canonical export jobs; read-only permits
# artifact writes. Worker uses INVESTMENTS_TENANT_ALLOWLIST; no separate deployment.
INVESTMENTS_ENABLED=false
# Optional backend rollout restriction; empty permits all otherwise-authorized
# organizations when INVESTMENTS_ENABLED=true. Invalid UUIDs fail startup.
INVESTMENTS_TENANT_ALLOWLIST=
# Backend emergency write freeze; permits explicitly classified read RPCs.
# Does not stop separately running workers or direct CLI/database writes.
INVESTMENTS_READ_ONLY=false
# Optional private /metrics listener for marketdata (including native history), investmentnav, investcbr and alphafx.
# Empty disables it. Use loopback locally; allow cluster monitoring only in k3s.
# This is not the budgetd METRICS_ADDR and does not enable any worker.
INVESTMENT_METRICS_ADDR=

# alphafx worker only: path to a mounted read-only Alpha Vantage token file.
# Never put the raw API key in this environment or NEXT_PUBLIC variables.
# When empty on macOS, alphafx uses budget.alphavantage.readonly in Keychain.
# The worker requires an already registered personal retrospective FX policy.
ALPHA_FX_TOKEN_FILE=

# marketdata --provider twelvedata: mounted read-only key file; raw keys never
# belong in environment variables. Empty on macOS uses budget.twelvedata.readonly.
# --provider moex uses public ISS without a credential. Both accept daily_candle
# jobs only, from reviewed historical mappings. T-Invest remains the default.
TWELVEDATA_KEY_FILE=
